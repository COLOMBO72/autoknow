# База данных
DATABASE_URL="postgresql://user:password@localhost:5432/autoknow"

# --- AI провайдер (агрегатор, OpenAI-совместимый API) ---
# Меняется без правки кода: base_url + api_key + название модели.
# Примеры base_url агрегаторов: https://api.aitunnel.ru/v1, https://api.proxyapi.ru/openai/v1
AI_BASE_URL="https://api.aitunnel.ru/v1"
AI_API_KEY="sk-xxxxx"
AI_MODEL="gpt-5-mini"          # дешёвая модель для форматирования отчёта

# --- Запасной провайдер (необязательно) ---
# Если заполнено — при полном отказе primary (не просто ошибке модели, а
# недоступности самого AITunnel) запрос уйдёт сюда, например в OpenRouter.
# Если оставить пустым — просто нет второй попытки.
AI_FALLBACK_BASE_URL="https://openrouter.ai/api/v1"
AI_FALLBACK_API_KEY=""
AI_FALLBACK_MODEL="openai/gpt-5-mini"

# --- ЮKassa (переиспользуем интеграцию с velium.ru) ---
YOOKASSA_SHOP_ID="xxxxx"
YOOKASSA_SECRET_KEY="xxxxx"

# --- Приложение ---
PORT=3000
REPORT_PRICE_KOPEKS=3000        # 30 руб за 1 машину при пакете 300р/10шт
COMPARISON_MAX_CARS=5

# --- Авторизация ---
JWT_SECRET="замени-на-длинную-случайную-строку"
APP_URL="http://localhost:3001"  # адрес фронтенда — нужен для ссылки сброса пароля

# --- Почта (сброс пароля) ---
# Любой SMTP-провайдер. Если оставить пустым — письма не отправляются
# по-настоящему, ссылка просто пишется в лог сервера (для разработки ок).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="autoknow <noreply@your-domain.ru>"

# --- Админка ---
ADMIN_EMAIL="fizikaestw@gmail.com"
